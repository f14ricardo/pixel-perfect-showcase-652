{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ahhdyuoekanvnfqdpnna.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sistema-notas-sesi",
      "version": "0.1.0",
      "title": "Sistema Notas SESI"
    },
    "tools": [
      {
        "name": "listar_alunos",
        "title": "Listar alunos",
        "description": "Lista alunos do CE 113, com filtro opcional por sala, status (AT/TR/RE) e busca por nome ou matrícula.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sala": {
              "description": "Código da sala, ex.: 9EF-A.",
              "type": "string"
            },
            "status": {
              "description": "Status do aluno.",
              "type": "string",
              "enum": [
                "AT",
                "TR",
                "RE"
              ]
            },
            "busca": {
              "description": "Trecho do nome ou matrícula.",
              "type": "string"
            },
            "limite": {
              "default": 50,
              "description": "Máximo de alunos retornados.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "boletim_aluno",
        "title": "Boletim do aluno",
        "description": "Retorna notas das 3 etapas por componente, a projeção (média) e a frequência de um aluno pelo id ou pelo nome.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "aluno_id": {
              "description": "ID do aluno.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "nome": {
              "description": "Nome (ou parte) do aluno, se o id não for conhecido.",
              "type": "string",
              "minLength": 2
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "registrar_nota",
        "title": "Registrar nota",
        "description": "Cria ou atualiza a nota de uma etapa (1, 2 ou 3) de um componente para um aluno. Requer perfil com permissão de escrita.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "aluno_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID do aluno."
            },
            "componente": {
              "type": "string",
              "minLength": 1,
              "description": "Sigla do componente, ex.: MA, LP, HI."
            },
            "etapa": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 3
                }
              ],
              "description": "Etapa da nota."
            },
            "nota": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nota de 0 a 10, ou null para limpar."
            }
          },
          "required": [
            "aluno_id",
            "componente",
            "etapa",
            "nota"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
